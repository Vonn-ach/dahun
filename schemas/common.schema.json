{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dahun.app/schemas/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "iso": { "type": "string", "pattern": "^[a-z]{3}$", "description": "ISO 639-3 code" },
    "entryId": { "type": "string", "pattern": "^[a-z]{3}-[0-9]{4}$" },
    "sentenceId": { "type": "string", "pattern": "^[a-z]{3}-s[0-9]{3,4}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "speaker-checked", "verified", "retired"] },
    "localized": {
      "type": "object",
      "properties": { "en": { "type": "string", "minLength": 1 }, "ms": { "type": "string", "minLength": 1 } },
      "required": ["en"],
      "additionalProperties": false
    },
    "localizedBoth": {
      "type": "object",
      "properties": { "en": { "type": "string", "minLength": 1 }, "ms": { "type": "string", "minLength": 1 } },
      "required": ["en", "ms"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "speaker": { "type": "string", "pattern": "^SPK[0-9]{2,3}$", "description": "Speaker code, never a real name" },
        "date": { "type": "string", "format": "date" },
        "form": { "type": "string", "minLength": 1, "description": "The form the speaker reviewed (a sentence's text). The review counts towards status only while this equals the current form (D013)." },
        "verdict": { "enum": ["ok", "fix", "unsure"] },
        "comment": { "type": "string" },
        "assistedBy": { "enum": ["ai", "human"] }
      },
      "required": ["speaker", "date", "form", "verdict"],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "file": { "type": "string", "pattern": "^[a-z]{3}-(?:[0-9]{4}|s[0-9]{3,4})__SPK[0-9]{2,3}(_[0-9]+)?\\.(m4a|mp3|ogg|webm)$", "description": "<entry or sentence id>__<speaker code>[_<take>].<ext>, inside the pack's audio/ folder" },
        "speaker": { "type": "string", "pattern": "^SPK[0-9]{2,3}$" },
        "form": { "type": "string", "minLength": 1, "description": "The written form the clip says: the entry's form or one of its variants (a sentence's text)" },
        "dialect": { "type": "string" }
      },
      "required": ["file", "speaker", "form"],
      "additionalProperties": false
    }
  }
}
